    given-names: Roberto
version: "0.1.0"
date-released: "2026-11-07"
license: MIT
repository-code: "https://github.com/rburgosm/observatori-bici-vlc"
url: "https://observatoribicivlc.org"
keywords:
  - seguridad vial
  - seguretat viària
  - bicicleta
  - patinete eléctrico
  - VMP
  - València
  - datos abiertos
  - dades obertes
